# Copy to .env for `make run`. Not used in containers.
PORT=8080
AWS_REGION=us-east-1
TABLE_NAME=privatepaste-local
ENV=dev
# Either point at DynamoDB Local (table is created automatically) ...
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# ... or remove the three lines above and use a real profile:
# AWS_PROFILE=privatepaste
SHUTDOWN_DELAY=0s
